{
  "name": "medforgetech-page",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["python_workers"],
  "main": "backend/app/main.py",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

"observability": {
  "enabled": true,
  "logs": {
    "enabled": true,
    "invocation_logs": true,
    "head_sampling_rate": 1
  },
  "traces": {
    "enabled": true,
    "head_sampling_rate": 1
  }
},

"previews": {
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
}